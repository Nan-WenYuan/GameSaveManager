{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "游戏存档管理器",
  "identifier": "com.game-save-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm web:tauri-dev",
    "beforeBuildCommand": "pnpm web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "游戏存档管理器",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
